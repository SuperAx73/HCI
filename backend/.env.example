PORT=4000

# Real Firebase project (default for this setup — no Java/emulators required).
# Generate this file in Firebase Console > Project settings > Service accounts
# > Generate new private key. Paste its full JSON content as a single line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=<your-project-id>.appspot.com

# Only set these if you later install Java and want to use the local emulators instead:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# FIREBASE_PROJECT_ID=oficios-dev
